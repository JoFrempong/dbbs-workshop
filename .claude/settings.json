{
  "permissions": {
    "deny": [
      "Edit(/data/raw/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '\"\\(now | localtime | strftime(\"%Y-%m-%d %H:%M:%S\"))  \\(.tool_input.command | gsub(\"\\n\"; \" ; \"))\"' >> \"$CLAUDE_PROJECT_DIR/.claude/command-log.txt\" 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
